[
  {
    "AlarmName": "LKS-Lambda-HighErrorRate",
    "AlarmDescription": "Triggers when Lambda function error count exceeds 1 within a 1-minute evaluation period",
    "Namespace": "AWS/Lambda",
    "MetricName": "Errors",
    "Dimensions": [
      {
        "Name": "FunctionName",
        "Value": "lks-demo-logger"
      }
    ],
    "Statistic": "Sum",
    "Period": 60,
    "EvaluationPeriods": 1,
    "Threshold": 1,
    "ComparisonOperator": "GreaterThanOrEqualToThreshold",
    "TreatMissingData": "notBreaching"
  },
  {
    "AlarmName": "LKS-Lambda-LatencySpike",
    "AlarmDescription": "Triggers when Lambda average execution duration exceeds 2000 milliseconds",
    "Namespace": "AWS/Lambda",
    "MetricName": "Duration",
    "Dimensions": [
      {
        "Name": "FunctionName",
        "Value": "lks-demo-logger"
      }
    ],
    "Statistic": "Average",
    "Period": 300,
    "EvaluationPeriods": 1,
    "Threshold": 2000,
    "ComparisonOperator": "GreaterThanThreshold",
    "TreatMissingData": "notBreaching"
  }
]

